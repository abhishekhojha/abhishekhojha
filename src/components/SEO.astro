---
interface Props {
  title: string;
  description?: string;
  keywords?: string;
  url?: string;
  image?: string | null;
  type?: "website" | "article";
  publishedTime?: string;
  updatedTime?: string;
  tags?: string[];
}

const {
  title,
  description = "Portfolio of Abhishekh Ojha - Software Engineer building scalable, responsive web applications and AI Automation Expert.",
  keywords = "Abhishekh Ojha, Software Engineer, Full Stack Developer, AI Engineer, AI Automation Expert, Web Developer, MERN Stack, Next.js, Indore, India",
  url = "https://www.abhishekhojha.com/",
  image = "/og-image.png",
  type = "website",
  publishedTime,
  updatedTime,
  tags = [],
} = Astro.props;

// Ensure meta descriptions stay within the 160-character search engine limit
function clampDescription(text: string, maxLength = 160): string {
  const normalized = text.replace(/\s+/g, " ").trim();
  if (normalized.length <= maxLength) return normalized;
  const sliced = normalized.slice(0, maxLength - 3);
  const lastSpace = sliced.lastIndexOf(" ");
  return `${lastSpace > 0 ? sliced.slice(0, lastSpace) : sliced}...`;
}

const metaDescription = clampDescription(description);

// Use tags as keywords if they exist
const finalKeywords =
  tags && tags.length > 0 ? [...tags, "Abhishekh Ojha"].join(", ") : keywords;

const fullImageUrl = image
  ? image.startsWith("http")
    ? image
    : `https://www.abhishekhojha.com${image}`
  : "https://www.abhishekhojha.com/abhishekh.png";

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Abhishekh Ojha",
  url: "https://www.abhishekhojha.com",
  image: "https://www.abhishekhojha.com/abhishekh.png",
  jobTitle: "Full-Stack & AI Systems Architect",
  description:
    "Building production SaaS MVPs & AI agents for founders (0 to scale) with Next.js, Node.js, LangChain, and AWS.",
  worksFor: {
    "@type": "Organization",
    name: "Westack.ai",
  },
  knowsAbout: [
    "Next.js",
    "Node.js",
    "LangChain",
    "AWS",
    "AI Agents",
    "SaaS MVPs",
    "TypeScript",
    "React",
    "AI Integration",
    "Backend Engineering",
    "REST APIs",
    "MongoDB",
    "PostgreSQL",
    "n8n",
    "LLMs",
  ],
  sameAs: [
    "https://www.linkedin.com/in/abhishekh-ojha-10802b215/",
    "https://github.com/abhishekhojha",
  ],
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Abhishekh Ojha — Full-Stack & AI Systems Architect",
  url: "https://www.abhishekhojha.com",
  potentialAction: {
    "@type": "SearchAction",
    target: "https://www.abhishekhojha.com/?s={search_term_string}",
    "query-input": "required name=search_term_string",
  },
};

const articleSchema =
  type === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: title,
        description: description,
        image: fullImageUrl,
        datePublished: publishedTime,
        dateModified: updatedTime,
        author: {
          "@type": "Person",
          name: "Abhishekh Ojha",
          url: "https://www.abhishekhojha.com",
        },
      }
    : null;
---

{/* Basic SEO */}
<title>{title}</title>
<meta name="description" content={metaDescription} />
<meta name="keywords" content={finalKeywords} />
<meta name="author" content="Abhishekh Ojha" />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<link rel="canonical" href={url} />

{/* Open Graph / Facebook */}
<meta property="og:type" content={type} />
<meta property="og:site_name" content="Abhishekh Ojha" />
<meta property="og:url" content={url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={metaDescription} />
<meta property="og:image" content={fullImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Abhishekh Ojha — Full Stack & AI Engineer" />
<meta property="og:locale" content="en_IN" />

{
  type === "article" && publishedTime && (
    <meta property="article:published_time" content={publishedTime} />
  )
}
{
  type === "article" && updatedTime && (
    <meta property="article:modified_time" content={updatedTime} />
  )
}
{type === "article" && tags.map((tag) => <meta property="article:tag" content={tag} />)}

{/* Twitter / X */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@abhishekhojha_" />
<meta name="twitter:creator" content="@abhishekhojha_" />
<meta name="twitter:url" content={url} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={metaDescription} />
<meta name="twitter:image" content={fullImageUrl} />
<meta name="twitter:image:alt" content="Abhishekh Ojha — Full Stack & AI Engineer" />

{/* Structured Data: Person */}
<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

{/* Structured Data: WebSite */}
<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

{/* Structured Data: Article (only on article pages) */}
{articleSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
)}

