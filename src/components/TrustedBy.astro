---
// TrustedBy.astro
---

<section
  class="py-10 mb-12 border-y border-gray-200/50 dark:border-gray-800/50 bg-gray-50/30 dark:bg-gray-900/20"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <p
      class="text-center text-sm font-semibold uppercase tracking-[0.15em] text-gray-500 dark:text-gray-400 mb-8"
    >
      Worked with & Trusted by
    </p>
    <div class="flex flex-wrap justify-center items-center gap-8 md:gap-16">
      <div
        class="h-16 md:h-20 max-w-[160px] overflow-hidden flex items-center justify-center hover:scale-105 transition-transform duration-300 dark:bg-white/95 dark:px-3 dark:rounded-xl"
      >
        <span
          style="font-family: 'IBM Plex Serif', serif; font-weight: 400; font-size: 2.5rem; letter-spacing: -0.02em;"
          class="text-gray-900 whitespace-nowrap"
        >
          BROYAL
        </span>
      </div>
      <div
        class="h-16 md:h-20 max-w-[160px] overflow-hidden flex items-center justify-center hover:scale-105 transition-transform duration-300"
      >
        <img
          src="/workedwith/wewon.svg"
          alt="WeWon"
          width="98"
          height="54"
          class="max-h-full max-w-full object-contain mix-blend-multiply dark:mix-blend-normal dark:bg-white/95 dark:p-2 dark:rounded-xl"
        />
      </div>
      <div
        class="h-16 md:h-20 max-w-[160px] overflow-hidden flex items-center justify-center hover:scale-105 transition-transform duration-300"
      >
        <img
          src="/workedwith/uttamfacility.webp"
          alt="Uttam Facility"
          width="231"
          height="229"
          class="max-h-full max-w-full object-contain mix-blend-multiply dark:mix-blend-normal dark:bg-white/95 dark:p-2 dark:rounded-xl"
        />
      </div>
      <div
        class="h-16 md:h-20 max-w-[160px] overflow-hidden flex items-center justify-center hover:scale-105 transition-transform duration-300"
      >
        <img
          src="/workedwith/steelgov.gif"
          alt="Government Project"
          width="509"
          height="250"
          class="max-h-full max-w-full object-contain mix-blend-multiply dark:mix-blend-normal dark:bg-white/95 dark:p-2 dark:rounded-xl"
        />
      </div>
      <div
        class="h-16 md:h-20 max-w-[160px] overflow-hidden flex items-center justify-center hover:scale-105 transition-transform duration-300"
      >
        <img
          src="/workedwith/sahiraste.webp"
          alt="Sahiraste"
          width="1736"
          height="906"
          class="max-h-full max-w-full object-contain mix-blend-multiply dark:mix-blend-normal dark:bg-white/95 dark:p-2 dark:rounded-xl"
        />
      </div>
    </div>
  </div>
</section>
