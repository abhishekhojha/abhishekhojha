---
// SocialProof.astro
---

<section class="py-12 px-4 sm:px-6 max-w-7xl mx-auto w-full mb-8">
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
    <!-- Stat 1 -->
    <div class="bg-white/80 dark:bg-gray-800/50 backdrop-blur-md rounded-2xl p-6 shadow-sm border border-gray-100 dark:border-gray-700/50 hover:-translate-y-1 hover:shadow-md transition-transform duration-300">
      <div class="text-3xl lg:text-4xl font-extrabold text-[var(--brand-dark)] dark:text-[var(--brand-light)] mb-2">5,000+</div>
      <div class="text-sm text-gray-600 dark:text-gray-400 font-medium">Payment Transactions</div>
    </div>
    
    <!-- Stat 2 -->
    <div class="bg-white/80 dark:bg-gray-800/50 backdrop-blur-md rounded-2xl p-6 shadow-sm border border-gray-100 dark:border-gray-700/50 hover:-translate-y-1 hover:shadow-md transition-transform duration-300">
      <div class="text-3xl lg:text-4xl font-extrabold text-[var(--brand-dark)] dark:text-[var(--brand-light)] mb-2">50+</div>
      <div class="text-sm text-gray-600 dark:text-gray-400 font-medium">Secured APIs Built</div>
    </div>
    
    <!-- Stat 3 -->
    <div class="bg-white/80 dark:bg-gray-800/50 backdrop-blur-md rounded-2xl p-6 shadow-sm border border-gray-100 dark:border-gray-700/50 hover:-translate-y-1 hover:shadow-md transition-transform duration-300">
      <div class="text-3xl lg:text-4xl font-extrabold text-[var(--brand-dark)] dark:text-[var(--brand-light)] mb-2">3+</div>
      <div class="text-sm text-gray-600 dark:text-gray-400 font-medium">Years Experience</div>
    </div>

    <!-- Highlight 1 -->
    <div class="bg-white/80 dark:bg-gray-800/50 backdrop-blur-md rounded-2xl p-6 shadow-sm border border-gray-100 dark:border-gray-700/50 hover:-translate-y-1 hover:shadow-md transition-transform duration-300 flex flex-col justify-center">
      <div class="font-bold text-gray-900 dark:text-gray-100 text-lg mb-1 flex items-center">
        <svg class="w-5 h-5 mr-2 text-[var(--brand-dark)] dark:text-[var(--brand-light)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
        AI Integration
      </div>
      <div class="text-sm text-gray-600 dark:text-gray-400 mt-1">Built scalable AI-powered products</div>
    </div>

    <!-- Highlight 2 -->
    <div class="bg-white/80 dark:bg-gray-800/50 backdrop-blur-md rounded-2xl p-6 shadow-sm border border-gray-100 dark:border-gray-700/50 hover:-translate-y-1 hover:shadow-md transition-transform duration-300 flex flex-col justify-center">
      <div class="font-bold text-gray-900 dark:text-gray-100 text-lg mb-1 flex items-center">
        <svg class="w-5 h-5 mr-2 text-[var(--brand-dark)] dark:text-[var(--brand-light)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
        Public Sector
      </div>
      <div class="text-sm text-gray-600 dark:text-gray-400 mt-1">Contributed to critical government projects</div>
    </div>

    <!-- Highlight 3 -->
    <div class="bg-white/80 dark:bg-gray-800/50 backdrop-blur-md rounded-2xl p-6 shadow-sm border border-gray-100 dark:border-gray-700/50 hover:-translate-y-1 hover:shadow-md transition-transform duration-300 flex flex-col justify-center">
      <div class="font-bold text-gray-900 dark:text-gray-100 text-lg mb-1 flex items-center">
        <svg class="w-5 h-5 mr-2 text-[var(--brand-dark)] dark:text-[var(--brand-light)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
        Data Pipelines
      </div>
      <div class="text-sm text-gray-600 dark:text-gray-400 mt-1">Developed college prediction engine</div>
    </div>
  </div>
</section>
