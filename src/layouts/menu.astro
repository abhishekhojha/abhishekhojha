---
// src/layouts/menu.astro
import { Github, Moon, Sun, Download } from "lucide-react";
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: "/", label: "Home", exact: true },
  { href: "/projects", label: "Projects" },
  { href: "/learnings", label: "Learnings" },
  { href: "/contact", label: "Contact" },
];
---

{/* ── Top bar ─────────────────────────────────────────────────────── */}
<div
  class="fixed w-full top-0 z-50 px-0 sm:px-4 py-4 md:py-6 pointer-events-none"
>
  <div
    class="container mx-auto flex justify-center sm:justify-between items-center gap-2 relative"
  >
    {/* Main Navigation */}
    <nav
      aria-label="Primary navigation"
      class="pointer-events-auto flex items-center h-10 sm:h-auto gap-0.5 sm:gap-4 rounded-full px-1.5 sm:px-3 py-1 sm:py-2 bg-white/75 dark:bg-gray-900/75 backdrop-blur-xl border border-white/40 dark:border-gray-700/40 shadow-[0_8px_32px_rgba(0,0,0,0.04)] dark:shadow-[0_8px_32px_rgba(0,0,0,0.3)] ring-1 ring-gray-900/5 dark:ring-white/5 transition-all duration-500"
    >
      {
        navLinks.map((link) => {
          const isActive = link.exact
            ? currentPath === link.href
            : currentPath.startsWith(link.href);
          return (
            <a
              href={link.href}
              class:list={[
                "relative px-2.5 sm:px-4 py-1 sm:py-1.5 text-xs sm:text-sm font-semibold rounded-full transition-all duration-300 whitespace-nowrap leading-none flex items-center h-8 sm:h-auto",
                isActive
                  ? "text-gray-900 dark:text-white bg-gray-900/5 dark:bg-white/10"
                  : "text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white hover:bg-gray-900/5 dark:hover:bg-white/10",
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>

    {/* Desktop actions (sm+) */}
    <div class="pointer-events-auto hidden sm:flex items-center gap-2">
      <a
        href="https://github.com/abhishekhojha"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub profile"
        class="inline-flex items-center justify-center w-9 h-9 rounded-full text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white bg-white/70 dark:bg-gray-900/70 border border-white/40 dark:border-gray-700/40 backdrop-blur-xl shadow-[0_8px_32px_rgba(0,0,0,0.04)] dark:shadow-[0_8px_32px_rgba(0,0,0,0.3)] transition-all duration-300"
      >
        <Github className="w-[15px] h-[15px]" strokeWidth={2} />
      </a>
      <button
        type="button"
        data-theme-toggle
        aria-label="Toggle dark mode"
        class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-white/70 dark:bg-gray-900/70 border border-white/40 dark:border-gray-700/40 backdrop-blur-xl shadow-[0_8px_32px_rgba(0,0,0,0.04)] dark:shadow-[0_8px_32px_rgba(0,0,0,0.3)] text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white transition-all duration-300"
      >
        <Sun className="hidden dark:block w-[15px] h-[15px]" strokeWidth={2} />
        <Moon className="block dark:hidden w-[15px] h-[15px]" strokeWidth={2} />
      </button>
      <a
        href="/ABHISHEKH_OJHA.pdf"
        download="ABHISHEKH_OJHA.pdf"
        aria-label="Download Resume"
        class="group inline-flex items-center justify-center gap-2 px-5 py-2 h-9 font-bold text-sm text-white dark:text-gray-900 bg-gray-900 dark:bg-white rounded-full shadow-lg hover:shadow-xl hover:-translate-y-0.5 transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 dark:focus:ring-white"
      >
        <span class="tracking-wide">Resume</span>
      </a>
    </div>

    {/* Mobile toggle button (< sm) — replaces bottom bar so it never overlaps the chatbot */}
    <div class="pointer-events-auto sm:hidden relative">
      <button
        id="mobile-actions-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-actions-menu"
        aria-label="Open quick actions menu"
        class="inline-flex items-center justify-center w-10 h-10 shrink-0 rounded-full bg-white/75 dark:bg-gray-900/75 border border-white/40 dark:border-gray-700/40 backdrop-blur-xl shadow-[0_8px_32px_rgba(0,0,0,0.04)] dark:shadow-[0_8px_32px_rgba(0,0,0,0.3)] ring-1 ring-gray-900/5 dark:ring-white/5 text-gray-700 dark:text-gray-200 transition-all duration-200 active:scale-95"
      >
        <svg
          id="mobile-toggle-open-icon"
          class="w-4 h-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="1"></circle>
          <circle cx="19" cy="12" r="1"></circle>
          <circle cx="5" cy="12" r="1"></circle>
        </svg>
        <svg
          id="mobile-toggle-close-icon"
          class="w-4 h-4 hidden"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M18 6 6 18"></path>
          <path d="m6 6 12 12"></path>
        </svg>
      </button>

      {/* Dropdown popover */}
      <div
        id="mobile-actions-menu"
        class="hidden absolute right-0 top-12 w-48 rounded-2xl p-1.5 bg-white/95 dark:bg-gray-900/95 backdrop-blur-xl border border-gray-200/80 dark:border-gray-700/70 shadow-xl ring-1 ring-black/5 dark:ring-white/5"
      >
        <a
          href="https://github.com/abhishekhojha"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
        >
          <Github className="w-4 h-4 text-gray-500 dark:text-gray-400" strokeWidth={2} />
          <span>GitHub</span>
        </a>

        <button
          type="button"
          data-theme-toggle
          class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors text-left"
        >
          <Sun className="hidden dark:block w-4 h-4 text-amber-400" strokeWidth={2} />
          <Moon className="block dark:hidden w-4 h-4 text-gray-500" strokeWidth={2} />
          <span class="dark:hidden">Dark Mode</span>
          <span class="hidden dark:inline">Light Mode</span>
        </button>

        <a
          href="/ABHISHEKH_OJHA.pdf"
          download="ABHISHEKH_OJHA.pdf"
          class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
        >
          <Download className="w-4 h-4 text-gray-500 dark:text-gray-400" strokeWidth={2} />
          <span>Resume</span>
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  function getMenuEls() {
    return {
      toggleBtn: document.getElementById("mobile-actions-toggle"),
      menu: document.getElementById("mobile-actions-menu"),
      openIcon: document.getElementById("mobile-toggle-open-icon"),
      closeIcon: document.getElementById("mobile-toggle-close-icon"),
    };
  }

  function setMobileMenuOpen(open: boolean) {
    const { toggleBtn, menu, openIcon, closeIcon } = getMenuEls();
    if (!toggleBtn || !menu) return;
    menu.classList.toggle("hidden", !open);
    toggleBtn.setAttribute("aria-expanded", String(open));
    openIcon?.classList.toggle("hidden", open);
    closeIcon?.classList.toggle("hidden", !open);
  }

  function initMenuControls() {
    document.querySelectorAll("[data-theme-toggle]").forEach((btn) => {
      const fresh = btn.cloneNode(true) as HTMLElement;
      btn.replaceWith(fresh);
      fresh.addEventListener("click", () => {
        const isDark = document.documentElement.classList.toggle("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");
      });
    });

    const toggleBtn = document.getElementById("mobile-actions-toggle");
    if (toggleBtn) {
      const freshToggle = toggleBtn.cloneNode(true) as HTMLElement;
      toggleBtn.replaceWith(freshToggle);
      freshToggle.addEventListener("click", (e) => {
        e.stopPropagation();
        const menu = document.getElementById("mobile-actions-menu");
        if (!menu) return;
        setMobileMenuOpen(menu.classList.contains("hidden"));
      });
    }

    setMobileMenuOpen(false);
  }

  if (!(window as any).__menuDocListenersBound) {
    (window as any).__menuDocListenersBound = true;
    document.addEventListener("click", (e) => {
      const { toggleBtn, menu } = getMenuEls();
      if (
        menu &&
        !menu.classList.contains("hidden") &&
        !menu.contains(e.target as Node) &&
        !toggleBtn?.contains(e.target as Node)
      ) {
        setMobileMenuOpen(false);
      }
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") setMobileMenuOpen(false);
    });
  }

  document.addEventListener("astro:page-load", initMenuControls);
</script>
